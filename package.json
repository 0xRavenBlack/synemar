{
  "name": "synemar",
  "productName": "Synemar",
  "version": "1.0.0",
  "description": "Fullscreen music visualizer with waveform + spectrum animation, custom background videos and colors.",
  "desktopName": "synemar",
  "main": "main.js",
  "author": {
    "name": "Synemar",
    "email": "synemar@example.com"
  },
  "homepage": "https://example.com/synemar",
  "scripts": {
    "start": "electron .",
    "test:tags": "node test/mp3tags.test.js",
    "icon": "node scripts/gen-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "license": "MIT",
  "build": {
    "appId": "com.synemar.app",
    "productName": "Synemar",
    "executableName": "synemar",
    "icon": "app.svg",
    "files": [
      "main.js",
      "preload.js",
      "mp3tags.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Synemar <synemar@example.com>",
      "syncDesktopName": true,
      "synopsis": "Fullscreen music visualizer",
      "executableName": "synemar"
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "jsmediatags": "^3.9.7"
  }
}